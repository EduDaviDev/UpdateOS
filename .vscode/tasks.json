{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-upos",
            "type": "shell",
            "command": "wsl",
            "args": [
                "make"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Compile the UpdateOS (make)"
        },
        {
            "label": "run-qemu",
            "type": "shell",
            "command": "wsl",
            "args": [
                "make",
				"run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "build-upos",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Execute the ISO on QEMU"
        },
        {
            "label": "clean-upos",
            "type": "shell",
            "command": "wsl",
            "args": [
                "make", "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Remove the folder build/"
        },
		{
            "label": "disk-format",
            "type": "shell",
            "command": "wsl",
            "args": [
                "make", "disk_format"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Format the disk"
        },
		{
            "label": "disk-update",
            "type": "shell",
            "command": "wsl",
            "args": [
                "make", "disk_update"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Sync disk <-> folder"
        },
		{
            "label": "disk_clean",
            "type": "shell",
            "command": "wsl",
            "args": [
                "make", "disk-clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Delete disk"
        },
    ]
}